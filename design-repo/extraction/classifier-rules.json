{
  "version": "1.0.0",
  "note": "Source-to-taxonomy mapping used by extraction/classify_routes.py. First matching rule wins. 'match' keys: tag, class (all listed classes present), classExact (exact class set), id, attr (attribute equals), containsTag, containsClass. Variants come from 'variant', or 'variantByClass' ([class, variant] pairs, first hit) with 'defaultVariant', or 'variantByAttr'. Rules describe the SOURCE DOM only; the AI-facing taxonomy is the section contract's semantic.id.",
  "rules": [
    {"match": {"tag": "header", "class": ["site-header"]}, "section": "shell.header", "variant": "site-nav"},
    {"match": {"tag": "header", "class": ["bar"]}, "section": "shell.header", "variant": "minimal-bar"},
    {"match": {"tag": "footer", "class": ["site-footer"]}, "section": "shell.footer", "variant": "full"},
    {"match": {"tag": "footer", "class": ["foot"]}, "section": "shell.footer", "variant": "minimal"},
    {"match": {"tag": "section", "classExact": ["hero", "container"]}, "section": "home.hero", "variant": "name-field"},
    {"match": {"tag": "section", "class": ["pbx-section"]}, "section": "home.work-showcase", "variant": "project-box"},
    {"match": {"tag": "section", "class": ["ai"]}, "section": "home.featured-project", "variant": "media-card"},
    {"match": {"tag": "section", "class": ["sk"]}, "section": "home.skills-index", "variant": "word-list"},
    {"match": {"tag": "section", "class": ["lw-hero"]}, "section": "about.intro", "variant": "photo-strip"},
    {"match": {"tag": "section", "class": ["dy-stage"]}, "section": "about.diary", "variant": "book"},
    {"match": {"tag": "section", "class": ["lw-end"]}, "section": "about.closing", "variant": "door"},
    {"match": {"tag": "section", "class": ["mw-head"]}, "section": "index.page-header", "variant": "title-dek"},
    {"match": {"tag": "section", "class": ["mw-stack"]}, "section": "index.project-grid", "variant": "card-grid"},
    {"match": {"tag": "section", "class": ["oc-closing"]}, "section": "conversion.closing", "variant": "link-row"},
    {"match": {"tag": "section", "class": ["section"], "containsTag": "h1"}, "section": "resume.header", "variant": "contact-meta"},
    {"match": {"tag": "section", "class": ["section"]}, "section": "conversion.closing", "variant": "cta-band"},
    {"match": {"tag": "section", "class": ["cs-section"]}, "section": "resume.entry-group", "variantByAttr": {"aria-labelledby": {"summary-heading": "summary", "experience-heading": "experience", "skills-heading": "skills", "education-heading": "education", "certifications-heading": "certifications"}}},
    {"match": {"tag": "section", "class": ["nda"]}, "section": "notice.protected-work", "variant": "redacted-sheet"},
    {"match": {"tag": "section", "class": ["cs2-hero", "short"]}, "section": "casestudy.hero", "variant": "stage"},
    {"match": {"tag": "section", "class": ["cs2-hero"]}, "section": "casestudy.hero", "variant": "split-media"},
    {"match": {"tag": "section", "class": ["v3-hero"]}, "section": "casestudy.hero", "variant": "journey"},
    {"match": {"tag": "section", "classExact": ["hero"]}, "section": "casestudy.hero", "variant": "poster"},
    {"match": {"tag": "section", "class": ["vx-hero"]}, "section": "casestudy.hero", "variant": "cover"},
    {"match": {"tag": "nav", "class": ["cs2-nav"]}, "section": "casestudy.chapter-nav", "variant": "anchor-list"},
    {"match": {"tag": "nav", "class": ["v3-nav"]}, "section": "casestudy.chapter-nav", "variant": "sticky-pills"},
    {"match": {"tag": "section", "class": ["v3-tldr"]}, "section": "casestudy.summary", "variant": "tldr-grid"},
    {"match": {"tag": "section", "class": ["vx-brief"]}, "section": "casestudy.summary", "variant": "brief-grid"},
    {"match": {"tag": "section", "class": ["file"]}, "section": "casestudy.summary", "variant": "flip-card"},
    {"match": {"tag": "section", "class": ["v3-problem"]}, "section": "casestudy.problem-statement", "variant": "statement-card"},
    {"match": {"tag": "section", "class": ["v3-bet"]}, "section": "casestudy.decision", "variant": "single"},
    {"match": {"tag": "section", "id": "decisions"}, "section": "casestudy.decision", "variant": "list"},
    {"match": {"tag": "section", "class": ["v3-console-section"]}, "section": "casestudy.scroll-narrative", "variant": "console"},
    {"match": {"tag": "section", "class": ["story"]}, "section": "casestudy.scroll-narrative", "variant": "panels"},
    {"match": {"tag": "section", "class": ["fork"]}, "section": "casestudy.scroll-narrative", "variant": "stepper"},
    {"match": {"tag": "section", "attr": {"aria-labelledby": "vx-screens-title"}}, "section": "casestudy.screen-gallery", "variant": "phone-trio"},
    {"match": {"tag": "section", "containsClass": "cs-nav-footer"}, "section": "conversion.closing", "variant": "link-row"},
    {"match": {"tag": "section", "class": ["cs2-end"]}, "section": "conversion.closing", "variant": "thanks-cta"},
    {"match": {"tag": "section", "class": ["end"]}, "section": "conversion.closing", "variant": "thanks-cta"},
    {"match": {"tag": "section", "class": ["v3-final"]}, "section": "conversion.closing", "variant": "final-statement"},
    {"match": {"tag": "section", "class": ["cs2-ch"]}, "section": "casestudy.chapter", "variantByClass": [["tint", "tint"]], "defaultVariant": "plain"},
    {"match": {"tag": "section", "class": ["v3-section"]}, "section": "casestudy.chapter", "variantByClass": [["v3-dark", "dark"], ["v3-tint", "tint"]], "defaultVariant": "plain"},
    {"match": {"tag": "section", "class": ["sec"]}, "section": "casestudy.chapter", "defaultVariant": "plain"}
  ]
}
