{
  "version": "1.0.0",
  "note": "One template per page purpose. Nodes are explicit slots (sections allowed in the slot, required, repeatable with min/max counts, allowed variants). The real classifier (extraction/classify_routes.py) checks that every route matches exactly its assigned template.",
  "metaBudgets": {
    "title": {
      "maxWords": 8
    },
    "description": {
      "maxWords": 31
    },
    "evidence": "max words of <title> / meta[name=description] over all 12 routes"
  },
  "templates": {
    "template.home": {
      "id": "template.home",
      "title": "Home",
      "purpose": "Portfolio home: name hero, work showcase, featured side project, skills index and an about-me band.",
      "nodes": [
        {
          "slot": "header",
          "sections": [
            "shell.header"
          ],
          "required": true,
          "repeatable": false,
          "variants": {
            "shell.header": [
              "site-nav"
            ]
          }
        },
        {
          "slot": "hero",
          "sections": [
            "home.hero"
          ],
          "required": true,
          "repeatable": false
        },
        {
          "slot": "work",
          "sections": [
            "home.work-showcase"
          ],
          "required": true,
          "repeatable": false
        },
        {
          "slot": "featured",
          "sections": [
            "home.featured-project"
          ],
          "required": false,
          "repeatable": false
        },
        {
          "slot": "skills",
          "sections": [
            "home.skills-index"
          ],
          "required": false,
          "repeatable": false
        },
        {
          "slot": "about-intro",
          "sections": [
            "about.intro"
          ],
          "required": false,
          "repeatable": false
        },
        {
          "slot": "about-diary",
          "sections": [
            "about.diary"
          ],
          "required": false,
          "repeatable": false
        },
        {
          "slot": "about-closing",
          "sections": [
            "about.closing"
          ],
          "required": false,
          "repeatable": false
        },
        {
          "slot": "footer",
          "sections": [
            "shell.footer"
          ],
          "required": true,
          "repeatable": false,
          "variants": {
            "shell.footer": [
              "full"
            ]
          }
        }
      ],
      "overlays": [
        "utility.mobile-menu",
        "utility.lock-modal",
        "utility.desktop-hint",
        "utility.media-lightbox",
        "utility.dreams-overlay"
      ],
      "noHero": false,
      "routes": [
        "index.html"
      ]
    },
    "template.project-index": {
      "id": "template.project-index",
      "title": "Project index",
      "purpose": "Every project as a card grid under a short header, closing with a contact line.",
      "nodes": [
        {
          "slot": "header",
          "sections": [
            "shell.header"
          ],
          "required": true,
          "repeatable": false,
          "variants": {
            "shell.header": [
              "site-nav"
            ]
          }
        },
        {
          "slot": "hero",
          "sections": [
            "index.page-header"
          ],
          "required": true,
          "repeatable": false
        },
        {
          "slot": "grid",
          "sections": [
            "index.project-grid"
          ],
          "required": true,
          "repeatable": false
        },
        {
          "slot": "closing",
          "sections": [
            "conversion.closing"
          ],
          "required": true,
          "repeatable": false,
          "variants": {
            "conversion.closing": [
              "link-row",
              "cta-band"
            ]
          }
        },
        {
          "slot": "footer",
          "sections": [
            "shell.footer"
          ],
          "required": true,
          "repeatable": false,
          "variants": {
            "shell.footer": [
              "full"
            ]
          }
        }
      ],
      "overlays": [
        "utility.mobile-menu",
        "utility.lock-modal"
      ],
      "noHero": false,
      "routes": [
        "projects.html"
      ]
    },
    "template.resume": {
      "id": "template.resume",
      "title": "Resume",
      "purpose": "A resume page: header with contacts, one section per resume part, and a call to see the work.",
      "nodes": [
        {
          "slot": "header",
          "sections": [
            "shell.header"
          ],
          "required": true,
          "repeatable": false,
          "variants": {
            "shell.header": [
              "site-nav"
            ]
          }
        },
        {
          "slot": "hero",
          "sections": [
            "resume.header"
          ],
          "required": true,
          "repeatable": false
        },
        {
          "slot": "parts",
          "sections": [
            "resume.entry-group"
          ],
          "required": true,
          "repeatable": true,
          "minCount": 1,
          "maxCount": 8
        },
        {
          "slot": "closing",
          "sections": [
            "conversion.closing"
          ],
          "required": true,
          "repeatable": false,
          "variants": {
            "conversion.closing": [
              "cta-band",
              "link-row"
            ]
          }
        },
        {
          "slot": "footer",
          "sections": [
            "shell.footer"
          ],
          "required": true,
