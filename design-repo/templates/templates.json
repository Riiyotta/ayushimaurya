      "routes": [
        "nda.html"
      ]
    },
    "template.case-study-brief": {
      "id": "template.case-study-brief",
      "title": "Case study (brief)",
      "purpose": "A short or gated case study: opener, at most a summary, one or two content sections (one chapter, or a screen gallery), and a closing.",
      "nodes": [
        {
          "slot": "header",
          "sections": [
            "shell.header"
          ],
          "required": true,
          "repeatable": false,
          "variants": {
            "shell.header": [
              "site-nav"
            ]
          }
        },
        {
          "slot": "hero",
          "sections": [
            "casestudy.hero"
          ],
          "required": true,
          "repeatable": false,
          "variants": {
            "casestudy.hero": [
              "stage",
              "cover"
            ]
          }
        },
        {
          "slot": "summary",
          "sections": [
            "casestudy.summary"
          ],
          "required": false,
          "repeatable": false,
          "variants": {
            "casestudy.summary": [
              "brief-grid"
            ]
          }
        },
        {
          "slot": "body",
          "sections": [
            "casestudy.chapter",
            "casestudy.screen-gallery"
          ],
          "required": true,
          "repeatable": true,
          "minCount": 1,
          "maxCount": 2
        },
        {
          "slot": "closing",
          "sections": [
            "conversion.closing"
          ],
          "required": true,
          "repeatable": false,
          "variants": {
            "conversion.closing": [
              "thanks-cta",
              "link-row"
            ]
          }
        },
        {
          "slot": "footer",
          "sections": [
            "shell.footer"
          ],
          "required": true,
          "repeatable": false,
          "variants": {
            "shell.footer": [
              "full"
            ]
          }
        }
      ],
      "overlays": [
        "utility.mobile-menu",
        "utility.media-lightbox"
      ],
      "noHero": false,
      "routes": [
        "claim-approval.html",
        "virtual-wardrobe.html",
        "wallet-ui.html",
        "visit-clinic-gift-cards.html"
      ]
    },
    "template.case-study-chaptered": {
      "id": "template.case-study-chaptered",
      "title": "Case study (chaptered, long-form)",
      "purpose": "A long-form case study decomposed into chapters: opener, optional summary/storyboard prelude, optional chapter nav, three or more chapter-level sections (chapters, problem statement, decisions, scroll narratives), and a closing.",
      "nodes": [
        {
          "slot": "header",
          "sections": [
            "shell.header"
          ],
          "required": true,
          "repeatable": false
        },
        {
          "slot": "hero",
          "sections": [
            "casestudy.hero"
          ],
          "required": true,
          "repeatable": false,
          "variants": {
            "casestudy.hero": [
              "split-media",
              "journey",
              "poster"
            ]
          }
        },
        {
          "slot": "prelude",
          "sections": [
            "casestudy.summary",
            "casestudy.scroll-narrative"
          ],
          "required": false,
          "repeatable": true,
          "minCount": 0,
          "maxCount": 2,
          "variants": {
            "casestudy.summary": [
              "tldr-grid",
              "flip-card"
            ],
            "casestudy.scroll-narrative": [
              "panels"
            ]
          }
        },
        {
          "slot": "chapter-nav",
          "sections": [
            "casestudy.chapter-nav"
          ],
          "required": false,
          "repeatable": false
        },
        {
          "slot": "body",
          "sections": [
            "casestudy.chapter",
            "casestudy.problem-statement",
            "casestudy.decision",
            "casestudy.scroll-narrative"
          ],
          "required": true,
          "repeatable": true,
          "minCount": 3,
          "maxCount": 30
        },
        {
          "slot": "closing",
          "sections": [
            "conversion.closing"
          ],
          "required": true,
          "repeatable": false,
          "variants": {
            "conversion.closing": [
              "thanks-cta",
              "final-statement"
            ]
          }
        },
        {
          "slot": "footer",
          "sections": [
            "shell.footer"
          ],
          "required": true,
          "repeatable": false
        }
      ],
      "overlays": [
        "utility.mobile-menu",
        "utility.media-lightbox",
        "utility.reading-progress"
      ],
      "noHero": false,
      "routes": [
        "hybrid-diagnostic.html",
        "visit-clinic.html",
        "family-ahc.html",
        "offline-doctor-consultation.html"
      ]
    }
  }
}
