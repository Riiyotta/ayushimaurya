          "variants": {
            "shell.footer": [
              "full"
            ]
          }
        }
      ],
      "overlays": [
        "utility.mobile-menu"
      ],
      "noHero": false,
      "routes": [
        "resume.html"
      ]
    },
    "template.notice": {
      "id": "template.notice",
      "title": "Protected-work notice",
      "purpose": "A single notice page for work under NDA; no hero (the notice is the whole, compact page).",
      "nodes": [
        {
          "slot": "header",
          "sections": [
            "shell.header"
          ],
          "required": true,
          "repeatable": false,
          "variants": {
            "shell.header": [
              "site-nav"
            ]
          }
        },
        {
          "slot": "notice",
          "sections": [
            "notice.protected-work"
          ],
          "required": true,
          "repeatable": false
        },
        {
          "slot": "footer",
          "sections": [
            "shell.footer"
          ],
          "required": true,
          "repeatable": false,
          "variants": {
            "shell.footer": [
              "full"
            ]
          }
        }
      ],
      "overlays": [
        "utility.mobile-menu"
      ],
